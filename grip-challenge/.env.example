# ─── Supabase ─────────────────────────────────────────────
# Leave NEXT_PUBLIC_SUPABASE_URL empty to run in demo mode (sample data, no SMS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Milestone engine, intake webhooks, cron, login pre-check.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Shared secrets ───────────────────────────────────────
# Apps Script sends it as "Authorization: Bearer <INTAKE_SECRET>".
INTAKE_SECRET=
# Netlify scheduled functions send it to /api/cron/*.
CRON_SECRET=

# ─── Club ─────────────────────────────────────────────────
# WhatsApp number for "אני רוצה לתאם" (digits, e.g. 972501234567). Falls back to the coach.
NEXT_PUBLIC_CLUB_WHATSAPP=
# Value of one membership month in ₪, for the prize-cost forecast. 0 = show months only.
NEXT_PUBLIC_MEMBERSHIP_MONTH_VALUE=0

# ─── Attendance ───────────────────────────────────────────
# manual (default) | boostapp — boostapp needs the two values below.
ATTENDANCE_PROVIDER=manual
# Boostapp: base https://rest.lee.co.il, header x-api-key, POST JSON.
BOOSTAPP_API_URL=https://rest.lee.co.il
BOOSTAPP_API_KEY=
# The check-ins endpoint, once Boostapp documents it.
BOOSTAPP_ATTENDANCE_PATH=

# ─── WhatsApp (Green API, Grip's business phone) ─────────
# From the instance page in the Green API console. Empty = dry run (logged, not sent).
GREEN_API_URL=https://7107.api.greenapi.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
# Supabase → Authentication → Hooks → "Send SMS hook" secret (v1,whsec_...).
# Login codes are delivered on WhatsApp through /api/auth/send-code.
SEND_CODE_HOOK_SECRET=
# Hours in Asia/Jerusalem
REMINDER_HOUR_IL=20
WEEKLY_HOUR_IL=21
