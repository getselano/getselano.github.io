# ─── Supabase ─────────────────────────────────────────────
# Leave NEXT_PUBLIC_SUPABASE_URL empty to run in demo mode (sample data, no SMS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Milestone engine, intake webhooks, cron, login pre-check.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Shared secrets ───────────────────────────────────────
# Apps Script sends it as "Authorization: Bearer <INTAKE_SECRET>".
INTAKE_SECRET=
# Netlify scheduled functions send it to /api/cron/*.
CRON_SECRET=

# ─── Club ─────────────────────────────────────────────────
# WhatsApp number for "אני רוצה לתאם" (digits, e.g. 972501234567). Falls back to the coach.
NEXT_PUBLIC_CLUB_WHATSAPP=
# Value of one membership month in ₪, for the prize-cost forecast. 0 = show months only.
NEXT_PUBLIC_MEMBERSHIP_MONTH_VALUE=0

# ─── Attendance ───────────────────────────────────────────
# manual (default) | boostapp — boostapp needs the two values below.
ATTENDANCE_PROVIDER=manual
BOOSTAPP_API_URL=
BOOSTAPP_API_KEY=

# ─── WhatsApp Cloud API ───────────────────────────────────
# Empty = dry run (messages are logged, not sent).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=he
WHATSAPP_TEMPLATE_DAILY=grip_daily_reminder
WHATSAPP_TEMPLATE_WEEKLY=grip_weekly_summary
WHATSAPP_TEMPLATE_STAFF=grip_staff_summary
# Hours in Asia/Jerusalem
REMINDER_HOUR_IL=20
WEEKLY_HOUR_IL=21
